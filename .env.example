# Postgres (docker-compose)
POSTGRES_DB=aria
POSTGRES_USER=aria
POSTGRES_PASSWORD=aria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App database URLs
DATABASE_URL=postgres://aria:aria@localhost:5432/aria?sslmode=disable
DATABASE_URL_READONLY=postgres://aria_readonly:aria_ro@localhost:5432/aria?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change_me_dev_only
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# OpenAI
OPENAI_API_KEY=placeholder_openai_key

# Frontend (used by CORS/config later)
FRONTEND_ORIGIN=http://localhost:3000
